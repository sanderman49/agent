{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "piInfrastructureReadPaths": [],
  "authorizerChain": [],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.docker/config.json": "deny",
      "~/.kube/*": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.azure/*": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/mcp-oauth/*": "deny",
      "~/.pi/agent/extensions/pi-permission-system/logs/*": "ask",
      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.netrc": "deny",
      "*.git-credentials": "deny"
    },
    "path_write": {
      "~/.pi/agent/extensions/pi-permission-system/config.json": "ask"
    },
    "web_enable": "ask",
    "bash": {
      "*": "allow",
      "curl *": "ask",
      "*/curl *": "ask",
      "wget *": "ask",
      "*/wget *": "ask",
      "http *": "ask",
      "*/http *": "ask",
      "https *": "ask",
      "*/https *": "ask",
      "httpie *": "ask",
      "*/httpie *": "ask",
      "aria2c *": "ask",
      "*/aria2c *": "ask",
      "lynx *": "ask",
      "*/lynx *": "ask",
      "w3m *": "ask",
      "*/w3m *": "ask",
      "links *": "ask",
      "*/links *": "ask",
      "elinks *": "ask",
      "*/elinks *": "ask"
    },
    "mcp": "allow",
    "skill": "allow",
    "external_directory": "ask",
    "external_directory_read": {
      "~/.pi": "allow",
      "~/.pi/*": "allow",
      "~/.nvm/versions/node/*/lib/node_modules/@earendil-works/pi-coding-agent": "allow",
      "~/.nvm/versions/node/*/lib/node_modules/@earendil-works/pi-coding-agent/*": "allow"
    }
  }
}
