{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "toolInputPreviewMaxLength": 400,
  "toolTextSummaryMaxLength": 120,
  "piInfrastructureReadPaths": [],
  "authorizerChain": [],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.docker/config.json": "deny",
      "~/.kube/*": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.azure/*": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/extensions/pi-permission-system/logs/*": "ask",
      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.netrc": "deny",
      "*.git-credentials": "deny",
      ".git/*": "deny"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": {
      "*": "allow",
      "~/.pi/agent/settings.json": "ask",
      "~/.pi/agent/models.json": "ask",
      "~/.pi/agent/APPEND_SYSTEM.md": "ask",
      "~/.pi/agent/agents/*": "ask",
      "~/.pi/agent/skills/*": "ask",
      "~/.pi/agent/extensions/*": "ask",
      "~/.pi/agent/package.json": "ask",
      "~/.pi/agent/package-lock.json": "ask",
      "~/.pi/agent/pnpm-lock.yaml": "ask"
    },
    "edit": {
      "*": "allow",
      "~/.pi/agent/settings.json": "ask",
      "~/.pi/agent/models.json": "ask",
      "~/.pi/agent/APPEND_SYSTEM.md": "ask",
      "~/.pi/agent/agents/*": "ask",
      "~/.pi/agent/skills/*": "ask",
      "~/.pi/agent/extensions/*": "ask",
      "~/.pi/agent/package.json": "ask",
      "~/.pi/agent/package-lock.json": "ask",
      "~/.pi/agent/pnpm-lock.yaml": "ask"
    },
    "ask_user_question": "allow",
    "subagent": "allow",
    "subagent_wait": "allow",
    "subagent_supervisor": "allow",
    "intercom": "allow",
    "memory": "allow",
    "memory_add": "allow",
    "memory_replace": "allow",
    "memory_remove": "allow",
    "memory_search": "allow",
    "session_search": "allow",
    "skill_manage": "ask",
    "edit_document": "allow",
    "bash": {
      "*": "ask",
      "true": "allow",
      "pwd": "allow",
      "pwd *": "allow",
      "test *": "allow",
      "date": "allow",
      "date +%s": "allow",
      "date +%Y-%m-%d": "allow",
      "date -u": "allow",
      "date -u +*": "allow",
      "date -u +* -s*": {
        "action": "deny",
        "reason": "UTC formatting is read-only; setting system time is not allowed"
      },
      "date -u +* --set*": {
        "action": "deny",
        "reason": "UTC formatting is read-only; setting system time is not allowed"
      },
      "whoami": "allow",
      "id *": "allow",
      "hostname": "allow",
      "uname *": "allow",
      "uptime": "allow",
      "which *": "allow",
      "type *": "allow",
      "command -v *": "allow",
      "command -V *": "allow",
      "du *": "allow",
      "df *": "allow",
      "diff *": "allow",
      "cmp *": "allow",
      "comm *": "allow",
      "md5sum *": "allow",
      "sha1sum *": "allow",
      "sha256sum *": "allow",
      "sha512sum *": "allow",
      "shasum *": "allow",
      "cksum *": "allow",
      "git --version": "allow",
      "node --version": "allow",
      "node -v": "allow",
      "npm --version": "allow",
      "npm -v": "allow",
      "pnpm --version": "allow",
      "pnpm -v": "allow",
      "yarn --version": "allow",
      "yarn -v": "allow",
      "python --version": "allow",
      "python3 --version": "allow",
      "pip --version": "allow",
      "pip3 --version": "allow",
      "tsc --version": "allow",
      "go version": "allow",
      "cargo --version": "allow",
      "rustc --version": "allow",
      "printf": "allow",
      "printf *": "allow",
      "echo *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "sed *": "ask",
      "sed --version": "allow",
      "sed --help": "allow",
      "sed --sandbox -n *": "allow",
      "sed *>*": "ask",
      "sed -i*": "deny",
      "sed * -i*": "deny",
      "sed * -*i*": "deny",
      "sed --in-place*": "deny",
      "sed * --in-place*": "deny",
      "tail *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "tree *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git reflog": "allow",
      "git reflog *": "allow",
      "git stash show": "allow",
      "git stash show *": "allow",
      "git stash list *": "allow",
      "git branch *": "ask",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch --list *": "allow",
      "git branch -a": "allow",
      "git branch -r": "allow",
      "git branch -vv": "allow",
      "git show *": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git grep *": "allow",
      "git blame *": "allow",
      "git rev-parse *": "allow",
      "git describe *": "allow",
      "git merge-base *": "allow",
      "git name-rev *": "allow",
      "git shortlog *": "allow",
      "git rev-list *": "allow",
      "git for-each-ref *": "allow",
      "git cat-file *": "allow",
      "git check-ignore *": "allow",
      "git count-objects *": "allow",
      "git diff-tree *": "allow",
      "git diff-files *": "allow",
      "git diff-index *": "allow",
      "git worktree list *": "allow",
      "git remote *": "ask",
      "git remote": "allow",
      "git remote -v": "allow",
      "git remote get-url *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "head *": "allow",
      "nl": "allow",
      "nl *": "allow",
      "jq *": "allow",
      "find": "allow",
      "find *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "rm -rf *": "deny",
      "sudo *": "ask"
    },
    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow",
      "mcp_search": "allow",
      "mcp_describe": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "external_directory": {
      "*": "ask",
      "~/.pi/*": "allow",
      "/tmp/pi-subagents-uid-1000/async-subagent-runs/*": "allow"
    }
  }
}
