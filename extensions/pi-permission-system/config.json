{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "toolInputPreviewMaxLength": 400,
  "toolTextSummaryMaxLength": 120,
  "piInfrastructureReadPaths": [],
  "authorizerChain": [],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      ".git/*": "deny"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "ask_user_question": "allow",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "echo *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "sed *": "allow",
      "sed -i*": "deny",
      "sed * -i*": "deny",
      "sed --in-place*": "deny",
      "sed * --in-place*": "deny",
      "tail *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "tree *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch": "allow",
      "git branch *": "ask",
      "git show *": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git grep *": "allow",
      "git blame *": "allow",
      "git rev-parse *": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git remote *": "ask",
      "rg": "allow",
      "rg *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "find": "allow",
      "find *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "npm test *": "allow",
      "npm run test *": "allow",
      "pnpm test *": "allow",
      "pnpm run test *": "allow",
      "yarn test *": "allow",
      "yarn run test *": "allow",
      "rm -rf *": "deny",
      "sudo *": "ask"
    },
    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow",
      "mcp_search": "allow",
      "mcp_describe": "allow"
    },
    "skill": {
      "*": "ask"
    },
    "external_directory": "ask"
  }
}
